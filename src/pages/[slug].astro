---
import Hero from "../components/Hero.astro";
import Layout from "../layouts/Layout.astro";
import Testimonials from '../components/Testimonials.astro';
import Navbar from '../components/Navbar.astro';
import Contact from '../components/Contact.astro';
import WhatsappButton from '../components/WhatsappButton.astro';
import Footer from '../components/Footer.astro';
import LocationInfo from '../components/LocationInfo.astro';
import NearbyAreas from '../components/NearbyAreas.astro';
import BodyServices from '../components/BodyServices.astro';
import BodyMethod from '../components/BodyMethod.astro';
import BodyPrevention from '../components/BodyPrevention.astro';
import BodyFaq from '../components/BodyFaq.astro';
import BodyCauses from '../components/BodyCauses.astro';
import BodyBrokenPipe from '../components/BodyBrokenPipe.astro';
import BodyQuote from '../components/BodyQuote.astro';
import Services from '../components/Services.astro';
import FAQ from '../components/FAQ.astro';
import { getCollection } from "astro:content";
import { serviceNode, breadcrumbNode, faqNode } from "../lib/schema";
import { deriveBodySections } from "../lib/bodySections";

export const prerender = true;

export async function getStaticPaths() {
    const locations = await getCollection("locations");
    const bySlug = new Map(locations.map((l) => [l.slug, l]));

    return locations.map((location) => {
        const nearby = [...new Set(location.data.nearbyBarrios ?? [])] // drop duplicates
            .filter((slug) => slug !== location.slug) // never self-link
            .flatMap((slug) => {
                const match = bySlug.get(slug);
                if (!match) {
                    console.warn(
                        `[locations] "${location.slug}" references unknown nearbyBarrios slug "${slug}" - link skipped.`
                    );
                    return [];
                }
                return [{ slug: match.slug, title: match.data.title }];
            });

        return {
            params: { slug: location.slug },
            props: { location, nearby }
        };
    });
}

const  {location, nearby} = Astro.props;
const {data} = location;
const { title, seoTitle, seoDescription, seoKeywords, h1, intro, span, zoneDescription} = data;
const { Content } = await location.render();
const hasBody = (location.body ?? "").trim().length > 0;
// Consumed by the navbar dropdown starting slice 5. Computed here so
// slice 5 never has to edit this file's data-derivation block, only its
// <Navbar /> call.
const bodySections = deriveBodySections(data as any);

// True only where the redesigned, structured body sections exist — today
// palermo and belgrano. It drives the INVERSE gate on the shared <Services />
// and <FAQ /> below: a page renders the barrio-specific pair or the generic
// pair, never both and never neither. That keeps the navbar's #servicios and
// #faq anchors resolving on all 33 pages, because Services.astro/FAQ.astro and
// BodyServices.astro/BodyFaq.astro publish those same two ids.
//
// It deliberately does NOT include `hasBody`. Villa-luro and devoto still carry
// their body as plain markdown with no structured fields; folding `hasBody` in
// here suppressed the generic pair on them while they had nothing to replace it
// with, leaving both anchors dead. When slice 4b migrates those two to
// frontmatter this flips for them on its own — no slug list to maintain.
const hasStructuredBody = Boolean(
    data.bodyServices || data.bodyMethod || data.bodyPrevention || data.bodyFaq
    || data.bodyCauses || data.bodyBrokenPipe || data.bodyQuote
);

const canonical = `https://kiafadestapaciones.com.ar/${location.slug}`;

const keywords = seoKeywords || `destapaciones ${title.toLowerCase()}, destapador ${title.toLowerCase()}, destapaciones caba, destapaciones consorcios, kiafa destapaciones`;

const schemaNodes = [
    serviceNode({ canonical, areaName: title }),
    breadcrumbNode({ canonical, name: title }),
    // Appended last and only when bodyFaq is present, so the graph emitted
    // for pages without it stays byte-identical to before this change.
    ...(data.bodyFaq ? [faqNode({ canonical, faqs: data.bodyFaq.items })] : []),
];
---

<Layout title={seoTitle} description={seoDescription} keywords={keywords} canonical={canonical} schemaNodes={schemaNodes}>
	<Navbar />
    <main id="main-content">
        <Hero title={h1} subtitle={intro} span={span} />
        <Testimonials />
        <LocationInfo title={title} zoneDescription={zoneDescription} />
        {(hasBody || hasStructuredBody) && (
            <>
                {hasBody && (
                    <section id="location-body" class="relative py-14 md:py-20 bg-slate-50">
                        <div class="max-w-3xl mx-auto px-6">
                            <Content />
                        </div>
                    </section>
                )}
                {/* hasBody does NOT gate the sections below: each is independently
                    gated on its own field. The order of these seven conditionals
                    IS the contract: bodyServices → bodyCauses → bodyBrokenPipe →
                    bodyQuote → bodyPrevention → bodyMethod → bodyFaq.
                    src/lib/bodySections.ts publishes a curated 4-entry subset of
                    this order (bodyServices, bodyPrevention, bodyMethod, bodyFaq)
                    for the navbar dropdown and must be edited in the same commit
                    whenever this order changes. The outer guard above exists only
                    so that when every one of these is absent (the 29 plain
                    landings today), this whole block collapses to a single false
                    expression instead of seven, keeping their HTML output
                    byte-identical to before this field set existed. */}
                {data.bodyServices   && <BodyServices   {...data.bodyServices} />}
                {data.bodyCauses     && <BodyCauses     {...data.bodyCauses} />}
                {data.bodyBrokenPipe && <BodyBrokenPipe {...data.bodyBrokenPipe} />}
                {data.bodyQuote      && <BodyQuote      {...data.bodyQuote} barrio={title} />}
                {data.bodyPrevention && <BodyPrevention {...data.bodyPrevention} />}
                {data.bodyMethod     && <BodyMethod     {...data.bodyMethod} />}
                {data.bodyFaq        && <BodyFaq        {...data.bodyFaq} />}
            </>
        )}
        {/* The generic pair, shown wherever the barrio-specific sections are
            absent — the 29 plain landings plus villa-luro and devoto until
            slice 4b. Product decision: those pages keep them because the pair
            is the bulk of what they say, while a migrated barrio replaces them
            with its own versions rather than carrying both. */}
        {!hasStructuredBody && (
            <>
                <Services />
                <FAQ />
            </>
        )}
        {nearby.length > 0 && <NearbyAreas current={title} items={nearby} />}
        <Contact barrio={title} />
    </main>
    <WhatsappButton barrio={title} />
    <Footer barrio={title} />
</Layout>


