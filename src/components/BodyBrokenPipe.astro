---
// Presentational only, per bodySections registry field "bodyBrokenPipe"
// ("Cuando la cañería está rota"). New component per #999 point 2 — not
// wired into BODY_SECTIONS/the navbar dropdown, per #1000 decision 3
// (reading material, not a navigation destination).
//
// Two-column intro (H2 + 2 paragraphs, photo placeholder) followed by two
// comparative excavation-cross-section cards. The closing callout
// ("ahorra trabajo de albañilería...") is deliberately NOT rendered here —
// Fabri asked it removed (#999) — its content backfill in slice 13 drops
// the equivalent sentence from source prose, not just this component.
//
// The two hand-written inline SVGs argue a point, not decorate: a diagnosis
// that doesn't localize the break forces a full-length trench (red), one
// that does forces a single small pit (green). Both share one soil/pipe
// visual language so only the excavation width differs between them —
// that contrast is the entire argument.
interface Props {
  heading: string;
  paragraphs: string[];
  photoCaption: string;
  diagramLabels: { withoutTramo: string; withTramo: string };
}

const { heading, paragraphs, photoCaption, diagramLabels } = Astro.props as Props;
---

<section id="cañeria-rota" class="relative py-24 bg-slate-50 scroll-mt-24">
  <div class="max-w-6xl mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div>
        <h2
          class="text-[46px] leading-tight font-extrabold text-slate-900
                 view-animate-single animate-fade-in-up animate-duration-500
                 animate-range-[entry_10%_contain_10%]"
        >
          {heading}
        </h2>
        {paragraphs.map((paragraph) => (
          <p class="mt-5 text-lg text-slate-600 leading-relaxed">{paragraph}</p>
        ))}
      </div>

      <div
        class="h-[300px] rounded-2xl border-2 border-dashed border-slate-300
               bg-white flex items-center justify-center
               view-animate-single animate-fade-in-up animate-duration-500
               animate-range-[entry_10%_contain_10%]"
      >
        <span class="text-sm font-semibold text-slate-400 uppercase tracking-wide">
          {photoCaption}
        </span>
      </div>
    </div>

    <h3
      class="mt-20 text-2xl md:text-3xl font-extrabold text-slate-900 text-center
             view-animate-single animate-fade-in-up animate-duration-500
             animate-range-[entry_10%_contain_10%]"
    >
      La diferencia que hace el diagnóstico
    </h3>

    <div class="mt-10 grid grid-cols-1 md:grid-cols-2 gap-6">
      <div
        class="rounded-2xl border-2 border-red-300 bg-white p-6
               view-animate-single animate-fade-in-up animate-duration-400
               animate-range-[entry_10%_contain_10%]"
      >
        <svg viewBox="0 0 320 160" width="100%" role="img" aria-labelledby="diagram-without-tramo">
          <title id="diagram-without-tramo">{diagramLabels.withoutTramo}</title>
          <defs>
            <pattern id="soil-a" width="10" height="10" patternTransform="rotate(45)" patternUnits="userSpaceOnUse">
              <line x1="0" y1="0" x2="0" y2="10" stroke="#cbd5e1" stroke-width="4" />
            </pattern>
          </defs>
          <rect x="0" y="28" width="320" height="112" fill="url(#soil-a)" />
          <rect x="0" y="0" width="320" height="28" fill="#f8fafc" />
          <line x1="0" y1="28" x2="320" y2="28" stroke="#94a3b8" stroke-width="2" />
          <rect x="18" y="28" width="284" height="72" rx="4" fill="#fef2f2" stroke="#fca5a5" stroke-width="2" stroke-dasharray="6 4" />
          <rect x="20" y="88" width="280" height="24" rx="12" fill="#ffffff" stroke="#475569" stroke-width="3" />
          <circle cx="176" cy="100" r="7" fill="#ef4444" />
          <path d="M170 94 l5 6 l6 -7" stroke="#ef4444" stroke-width="2" fill="none" stroke-linecap="round" />
        </svg>
        <p class="mt-5 text-center text-base font-bold text-red-600">
          {diagramLabels.withoutTramo}
        </p>
      </div>

      <div
        class="rounded-2xl border-2 border-emerald-300 bg-white p-6
               view-animate-single animate-fade-in-up animate-duration-400
               animate-range-[entry_10%_contain_10%]"
      >
        <svg viewBox="0 0 320 160" width="100%" role="img" aria-labelledby="diagram-with-tramo">
          <title id="diagram-with-tramo">{diagramLabels.withTramo}</title>
          <defs>
            <pattern id="soil-b" width="10" height="10" patternTransform="rotate(45)" patternUnits="userSpaceOnUse">
              <line x1="0" y1="0" x2="0" y2="10" stroke="#cbd5e1" stroke-width="4" />
            </pattern>
          </defs>
          <rect x="0" y="28" width="320" height="112" fill="url(#soil-b)" />
          <rect x="0" y="0" width="320" height="28" fill="#f8fafc" />
          <line x1="0" y1="28" x2="320" y2="28" stroke="#94a3b8" stroke-width="2" />
          <rect x="20" y="88" width="280" height="24" rx="12" fill="#ffffff" stroke="#475569" stroke-width="3" />
          <rect x="146" y="28" width="60" height="72" rx="4" fill="#ecfdf5" stroke="#6ee7b7" stroke-width="2" stroke-dasharray="6 4" />
          <circle cx="176" cy="100" r="7" fill="#ef4444" />
          <path d="M170 94 l5 6 l6 -7" stroke="#ef4444" stroke-width="2" fill="none" stroke-linecap="round" />
        </svg>
        <p class="mt-5 text-center text-base font-bold text-emerald-600">
          {diagramLabels.withTramo}
        </p>
      </div>
    </div>
  </div>
</section>
