---
// Presentational only, per bodySections registry field "bodyMethod".
// Reuses ServiceCard.astro verbatim (full weight: chip, h3, description)
// for exactly two items. The section band is bg-slate-50, so the two
// cards override ServiceCard's default bg-slate-50 to bg-white via
// cardClass, otherwise the card background would vanish into the band.
import { Route, Cone } from "@lucide/astro";
import ServiceCard from "./ServiceCard.astro";

interface Props {
  heading: string;
  lead?: string[];
  items: { term: string; description: string }[];
  note?: string[];
}

const { heading, lead, items, note } = Astro.props as Props;

// Two items only (schema caps bodyMethod.items at 2), so a positional
// two-entry icon array needs no icon key in frontmatter.
const ICONS = [Route, Cone];
---

<section id="metodo" class="relative py-24 bg-slate-50 scroll-mt-24">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center mb-14">
      <h2
        class="text-3xl md:text-4xl font-extrabold text-slate-900
               view-animate-single animate-fade-in-up animate-duration-500
               animate-range-[entry_10%_contain_10%]"
      >
        {heading}
      </h2>
      {lead && lead.map((paragraph) => (
        <p class="mt-6 text-lg text-slate-600 max-w-3xl mx-auto text-center">
          {paragraph}
        </p>
      ))}
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
      {items.map((item, index) => (
        <div
          class="view-animate-single animate-slide-up-fade animate-duration-400
                 animate-range-[entry_10%_contain_10%]"
        >
          <ServiceCard
            icon={ICONS[index] ?? ICONS[ICONS.length - 1]}
            title={item.term}
            description={item.description}
            cardClass="bg-white"
          />
        </div>
      ))}
    </div>

    {note && note.map((paragraph) => (
      <p class="mt-10 text-lg text-slate-600 max-w-3xl mx-auto text-center">
        {paragraph}
      </p>
    ))}
  </div>
</section>
