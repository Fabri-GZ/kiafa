---
// Internal linking between barrio landings. Restyled in slice 6 to extend the
// card system the redesigned body sections already use (BodyCauses tokens:
// rounded-2xl slate-50 card, blue-100 icon chip, uppercase blue-600 eyebrow).
//
// The props contract is unchanged on purpose. This section still renders only
// where `nearbyBarrios` already exists in the frontmatter, so no page gains or
// loses it — widening it would put a differential HTML change between the
// treated and control arms of the running experiment.
//
// The anchor text stays the full "Destapaciones en {barrio}": the eyebrow and
// the title are both inside the <a>, so the accessible name is unchanged.
import { Icon } from "astro-icon/components";

interface Props {
  current: string;
  items: { slug: string; title: string }[];
}

const { current, items } = Astro.props as Props;
---

{items.length > 0 && (
  <section id="zonas-cercanas" class="relative py-14 md:py-20 bg-white scroll-mt-24">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-14">
        <h2
          class="text-4xl md:text-5xl font-extrabold text-slate-900
                 view-animate-single animate-fill-both animate-fade-in-up animate-duration-500
                 animate-range-[entry_0%_contain_10%]"
        >
          Zonas cercanas a {current}
        </h2>
        <p class="mt-6 text-lg text-slate-600 max-w-3xl mx-auto">
          También ofrecemos destapaciones en los barrios linderos.
        </p>
      </div>

      <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {items.map((item) => (
          <li
            class="view-animate-single animate-fill-both animate-fade-in-up animate-duration-400
                   animate-range-[entry_0%_contain_10%]"
          >
            <a
              href={`/${item.slug}`}
              class="group h-full rounded-2xl bg-slate-50 border border-slate-200 p-7
                     flex items-center gap-5
                     hover:bg-white hover:border-blue-300 transition-colors duration-300 ease-in-out"
            >
              <span class="inline-flex w-14 h-14 shrink-0 rounded-2xl bg-blue-100 items-center justify-center text-blue-700">
                <Icon name="akar-icons:location" class="w-7 h-7" />
              </span>

              <span class="min-w-0">
                <span class="block text-sm font-bold text-blue-600 uppercase tracking-[.06em]">
                  Destapaciones en
                </span>
                <span class="block mt-1 text-[22px] font-bold text-slate-900">
                  {item.title}
                </span>
              </span>

              <Icon
                name="akar-icons:chevron-right"
                class="w-5 h-5 ml-auto shrink-0 text-slate-400 group-hover:text-blue-600 transition-colors duration-300 ease-in-out"
                aria-hidden="true"
              />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
