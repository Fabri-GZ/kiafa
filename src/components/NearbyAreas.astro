---
interface Props {
  current: string;
  items: { slug: string; title: string }[];
}

const { current, items } = Astro.props as Props;
---

{items.length > 0 && (
  <section id="zonas-cercanas" class="relative py-24 bg-white">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-12">
        <h2 class="text-4xl md:text-5xl font-extrabold text-slate-900">
          Zonas cercanas a {current}
        </h2>
        <p class="mt-4 text-lg text-slate-600 max-w-3xl mx-auto">
          También ofrecemos destapaciones en los barrios linderos.
        </p>
      </div>

      <ul class="flex flex-wrap justify-center gap-4">
        {items.map((item) => (
          <li>
            <a
              href={`/${item.slug}`}
              class="inline-block px-5 py-3 rounded-xl bg-blue-50 text-blue-700 font-semibold hover:bg-blue-100 transition-colors"
            >
              Destapaciones en {item.title}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
