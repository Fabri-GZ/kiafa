---
// Presentational only, per bodySections registry field "bodyServices".
// Redesigned per #999 (approved visual design), superseding the plainer
// version this component originally shipped with.
//
// Heading is intentionally text-5xl md:text-6xl, matching Services.astro's
// #servicios heading size exactly. This is a deliberate per-section
// override of the "one tier below page frame" default the rest of the
// body sections still follow (see BodyPrevention.astro, BodyFaq.astro at
// text-3xl md:text-4xl) — do not "fix" this back to match them. Density
// still separates this section from #servicios: 3 columns vs 2, one-line
// items vs multi-line cards, a repeated tick icon vs one icon per service.
//
// The closing "note" paragraph(s) render as a dark video-inspection card
// instead of plain centered text below the grid. This is not new copy:
// every location that populates bodyServices.note already writes it about
// the site's video inspection service (see destapaciones-palermo.md /
// destapaciones-belgrano.md), so the card is a restyle of existing
// verbatim content, not an added claim.
//
// `items` is read from SHARED_SERVICE_ITEMS, not from Astro.props, per
// #1002 decision 2: the seven-item list is identical on every barrio page,
// so it lives once in src/lib/bodySections.ts instead of 33 frontmatter
// copies that can (and did) drift out of sync.
import { Icon } from "astro-icon/components";
import { SHARED_SERVICE_ITEMS } from "../lib/bodySections";

interface Props {
  heading: string;
  lead?: string[];
  note?: string[];
}

const { heading, lead, note } = Astro.props as Props;
const items = SHARED_SERVICE_ITEMS;
---

<section id="servicios" class="relative py-14 md:py-20 bg-white scroll-mt-24">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center mb-14">
      <h2
        class="text-5xl md:text-6xl font-extrabold text-slate-900
               view-animate-single animate-fill-both animate-fade-in-up animate-duration-500
               animate-range-[entry_0%_contain_10%]"
      >
        {heading}
      </h2>
      {lead && lead.map((paragraph) => (
        <p class="mt-6 text-lg text-slate-600 max-w-3xl mx-auto text-center">
          {paragraph}
        </p>
      ))}
    </div>

    <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {items.map((item, index) => (
        <li
          class:list={[
            "group flex items-center gap-4 rounded-xl border border-slate-200 bg-white p-7",
            "transition-colors duration-200 hover:border-blue-300 hover:bg-blue-50/40",
            "view-animate-single animate-fill-both animate-fade-in-up animate-duration-400",
            "animate-range-[entry_0%_contain_10%]",
            // An orphan card alone on the last `lg` row (3-col grid) gets
            // centered instead of sitting on the left — the "seventh card"
            // case #999 calls out, generalized to any item count that
            // leaves exactly one card on the final row.
            items.length % 3 === 1 && index === items.length - 1
              ? "lg:col-start-2"
              : "",
          ]}
        >
          <span class="shrink-0 w-[52px] h-[52px] rounded-[14px] bg-blue-100 flex items-center justify-center text-blue-700">
            <Icon name="akar-icons:check" class="w-6 h-6 [&_*]:stroke-[3.2]" />
          </span>
          <span class="text-base font-semibold text-slate-900">{item}</span>
        </li>
      ))}
    </ul>

    {note && (
      <div
        class="mt-10 flex items-center gap-5 rounded-2xl bg-slate-900 p-7
               view-animate-single animate-fill-both animate-fade-in-up animate-duration-500
               animate-range-[entry_0%_contain_10%]"
      >
        <span class="shrink-0 w-14 h-14 rounded-2xl bg-white/10 flex items-center justify-center text-white">
          <Icon name="akar-icons:video" class="w-7 h-7" />
        </span>
        <div>
          {note.map((paragraph) => (
            <p class="text-base text-slate-100 leading-relaxed">{paragraph}</p>
          ))}
        </div>
      </div>
    )}
  </div>
</section>
