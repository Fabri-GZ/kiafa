---
// Presentational only, per bodySections registry field "bodyFaq". Reuses
// FAQ.astro's flyonui accordion markup verbatim (including the
// `border-slate-700` hairline, kept for visual consistency with #faq
// rather than "fixed" here). Uses id="faq-barrio" and item ids
// "${index}-faq-barrio" so nothing collides with #faq or its
// servicios-faq/pago-faq/presupuesto-faq/clientes-faq ids on the same
// page.
//
// Per #999 point 6, each question now gets a 48px bg-blue-100 icon chip
// (without it the section read "too sober") and the chevron moves to the
// right of the question text. First item's blue soft-shadow already comes
// from the wrapper's `accordion-item-active:shadow-blue-500/20`, unchanged.
//
// Icon assignment is positional, per #998's fixed 4-topic mapping (PH and
// older houses, commercial kitchens, broken pipe, quote), because both
// barrios that populate this field today (palermo, belgrano) carry exactly
// 4 items. Palermo's 4 questions match these topics in this exact order;
// belgrano's diverge in wording (its own local angle on the same 4 slots)
// but reuse the same positional icons rather than inventing a fifth rule.
import { Icon } from "astro-icon/components";

const FAQ_ICONS = [
  "akar-icons:home",
  "akar-icons:utensils",
  "mdi:pipe-leak",
  "akar-icons:file",
] as const;

interface Props {
  heading: string;
  lead?: string[];
  items: { question: string; answer: string }[];
  note?: string[];
}

const { heading, lead, items, note } = Astro.props as Props;
---

<section id="faq-barrio" class="relative py-24 bg-slate-50 scroll-mt-24">
  <div class="max-w-4xl mx-auto px-6">
    <div class="text-center mb-14">
      <h2
        class="text-3xl md:text-4xl font-extrabold text-slate-900
               view-animate-single animate-fade-in-up animate-duration-500
               animate-range-[entry_10%_contain_10%]"
      >
        {heading}
      </h2>
      {lead && lead.map((paragraph) => (
        <p class="mt-6 text-lg text-slate-600 max-w-3xl mx-auto text-center">
          {paragraph}
        </p>
      ))}
    </div>

    <div class="accordion accordion-shadow *:accordion-item-active:shadow-md *:accordion-item-active:shadow-blue-500/20">
      {items.map((item, index) => {
        const itemId = `${index}-faq-barrio`;
        const isFirst = index === 0;
        return (
          <div
            class:list={[
              "accordion-item accordion-item-active:scale-[1.05] accordion-item-active:my-3 transition-all ease-in duration-300 bg-white rounded-xl border border-slate-700 hover:border-slate-600 view-animate-single animate-zoom-in animate-duration-400 animate-range-[entry_10%_contain_10%]",
              { active: isFirst },
            ]}
            id={itemId}
          >
            <button
              class="accordion-toggle inline-flex items-center gap-x-4 px-5 py-4 text-start w-full group"
              aria-controls={`${itemId}-collapse`}
              aria-expanded={isFirst ? "true" : "false"}
            >
              <span class="shrink-0 w-12 h-12 rounded-xl bg-blue-100 flex items-center justify-center text-blue-700">
                <Icon name={FAQ_ICONS[index % FAQ_ICONS.length]} class="w-5 h-5" />
              </span>
              <span class="flex-1 text-lg font-semibold text-slate-900">
                {item.question}
              </span>
              <Icon
                name="akar-icons:chevron-down"
                class="w-5 h-5 shrink-0 text-slate-400 transition-transform duration-300 accordion-item-active:rotate-180"
              />
            </button>

            <div
              id={`${itemId}-collapse`}
              class:list={["accordion-content w-full overflow-hidden transition-[height] duration-300", { hidden: !isFirst }]}
              aria-labelledby={itemId}
              role="region"
            >
              <div class="px-6 pb-5">
                <p class="text-slate-600 leading-relaxed">{item.answer}</p>
              </div>
            </div>
          </div>
        );
      })}
    </div>

    {note && note.map((paragraph) => (
      <p class="mt-10 text-lg text-slate-600 max-w-3xl mx-auto text-center">
        {paragraph}
      </p>
    ))}
  </div>
</section>
<script>
  import "flyonui/dist/accordion.js";
</script>
