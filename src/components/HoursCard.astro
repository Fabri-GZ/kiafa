---
import { Clock } from "@lucide/astro";
import { HOURS_TEXT_ES } from "../lib/schema";

const {
  animationClass = "view-animate-single animate-[slide-in-right-strong] animate-duration-500 animate-range-[entry_30%_contain_50%]",
} = Astro.props;
---
<div class={`flex items-start gap-5 ${animationClass}`}>
  <div class="shrink-0 w-14 h-14 rounded-2xl bg-blue-100 flex items-center justify-center text-blue-700">
    <Clock class="w-7 h-7" />
  </div>
  <div>
    <h3 class="text-2xl font-semibold text-slate-900 mb-2">
      Lunes a sábado
    </h3>
    <p class="text-slate-600 text-lg">
      {HOURS_TEXT_ES}
    </p>
  </div>
</div>
