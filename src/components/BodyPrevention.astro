---
// Presentational only, per bodySections registry field "bodyPrevention".
// Not cards: no border, no background, no icon chip. Layout borrowed from
// LocationInfo.astro's two-column "flex items-start gap-5" items, with a
// tabular-nums ordinal numeral replacing the icon chip. This is the third
// density on the page (card-heavy #metodo above, borderless list here,
// accordion in #faq-barrio below).
//
// This is the one section #997 approved as-is ("no está tan mal"), so
// slice 7 confirms-and-polishes rather than rebuilds: the only change is
// bumping the heading one step (text-4xl/5xl) so it doesn't read as
// visually orphaned now that #que-destapamos above jumped to
// text-5xl/6xl (slice 6). Full harmonization against #metodo still waits
// on that section's own redesign (slice 11) — this is an interim step,
// not the final scale.
interface Props {
  heading: string;
  lead?: string[];
  items: { term: string; description: string }[];
  note?: string[];
}

const { heading, lead, items, note } = Astro.props as Props;
---

<section id="prevencion" class="relative py-14 md:py-20 bg-white scroll-mt-24">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center mb-14">
      <h2
        class="text-4xl md:text-5xl font-extrabold text-slate-900
               view-animate-single animate-fill-both animate-fade-in-up animate-duration-500
               animate-range-[entry_0%_contain_10%]"
      >
        {heading}
      </h2>
      {lead && lead.map((paragraph) => (
        <p class="mt-6 text-lg text-slate-600 max-w-3xl mx-auto text-center">
          {paragraph}
        </p>
      ))}
    </div>

    <ol class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-10">
      {items.map((item, i) => (
        <li
          class="flex items-start gap-5 view-animate-single animate-fill-both animate-[slide-in-left-strong]
                 animate-duration-500 animate-range-[entry_0%_contain_10%]"
        >
          <span class="shrink-0 w-12 text-4xl font-extrabold text-blue-600 tabular-nums leading-none">
            {String(i + 1).padStart(2, "0")}
          </span>
          <div>
            <h3 class="text-xl font-semibold text-slate-900 mb-2">{item.term}</h3>
            <p class="text-slate-600 leading-relaxed">{item.description}</p>
          </div>
        </li>
      ))}
    </ol>

    {note && note.map((paragraph) => (
      <p class="mt-10 text-lg text-slate-600 max-w-3xl mx-auto text-center">
        {paragraph}
      </p>
    ))}
  </div>
</section>
