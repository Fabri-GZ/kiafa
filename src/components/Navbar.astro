---
import { Menu, X, House, Users, Wrench, Info } from "@lucide/astro";

// `sections` comes from deriveBodySections() in src/lib/bodySections.ts — the
// curated four-entry subset, filtered to the ones the page actually declares.
// It is empty on the home and on every landing without structured body fields,
// and an empty array renders NOTHING extra, so those pages keep the navbar they
// already had, byte for byte.
//
// On a barrio page the dropdown REPLACES the standalone "Servicios" and
// "Preguntas frecuentes" links rather than sitting beside them: BODY_SECTIONS
// publishes the ids `servicios` and `faq`, which are exactly what those two
// links already target, so keeping both would put two entries on one anchor.
interface Props {
  barrio?: string;
  sections?: { id: string; label: string }[];
}
const { barrio, sections = [] } = Astro.props as Props;
const hasDropdown = sections.length > 0 && Boolean(barrio);
---

<header class="fixed top-0 inset-x-0 z-50" id="header-nav">
  <nav class="max-w-screen-2xl mx-auto px-10 h-22 flex items-center justify-between navbar-wrapper view-animate-single animate-fill-both animate-fade-in-down animate-duration-500">

    <a href="/" class="flex items-center">
      <img src="/logo-kiafa-black.webp" alt="Kiafa Destapaciones" class="h-12 w-auto object-contain" loading="eager" />
    </a>

    <ul class="hidden md:flex items-center gap-8 font-medium text-lg text-black">
      <li><a href="#inicio" class="hover:text-blue-600 transition duration-150 ease-in">Inicio</a></li>
      <li><a href="#nosotros" class="hover:text-blue-600 transition duration-150 ease-in">Sobre nosotros</a></li>
      {hasDropdown ? (
        <li class="relative">
          <details class="group" data-nav-dropdown>
            <summary
              class="flex items-center gap-1.5 cursor-pointer list-none [&::-webkit-details-marker]:hidden
                     hover:text-blue-600 transition duration-150 ease-in"
            >
              {barrio}
              <svg class="w-4 h-4 transition-transform duration-200 group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M6 9l6 6 6-6" />
              </svg>
            </summary>
            <ul class="absolute left-0 top-full mt-4 min-w-60 rounded-2xl border border-slate-200 bg-white p-2 shadow-xl shadow-slate-900/10">
              {sections.map((section) => (
                <li>
                  <a
                    href={`#${section.id}`}
                    class="block rounded-xl px-4 py-2.5 text-base text-slate-700 hover:bg-slate-50 hover:text-blue-600 transition-colors"
                  >
                    {section.label}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        </li>
      ) : (
        <>
          <li><a href="#servicios" class="hover:text-blue-600 transition duration-150 ease-in">Servicios</a></li>
          <li><a href="#faq" class="hover:text-blue-600 transition duration-150 ease-in">Preguntas frecuentes</a></li>
        </>
      )}

      <li>
        <a
          href="#contacto"
          class="items-center justify-center rounded-xl px-4 py-2 text-lg font-semibold text-white bg-blue-600 shadow-lg shadow-blue-500/30 hover:bg-blue-500 hover:shadow-blue-400/60 transition-all duration-200 ease-in menu-link"
        >
        Contacto
        </a>
      </li>
    </ul>

    <button
      id="menu-button"
      class="md:hidden z-60"
      aria-label="Abrir menú"
    >
      <Menu id="icon-menu" class="w-7 h-7 text-black transition-transform duration-200" />
      <X id="icon-close" class="w-7 h-7 text-black hidden transition-transform duration-200" />
    </button>
  </nav>
</header>

<div id="mobile-overlay" class="hidden fixed inset-0 z-50 md:hidden">
  <div
    id="mobile-backdrop"
    class="absolute inset-0 bg-black/40 opacity-0 transition-opacity duration-300"
  ></div>

  <nav 
    id="mobile-menu" 
    class="relative w-[65%] max-w-sm h-full bg-white shadow-xl px-6 py-8 flex flex-col gap-8 -translate-x-full transition-transform duration-300 ease-out"
  >
    <img
      src="/logo-kiafa-black.webp"
      alt="Kiafa Destapaciones"
      class="h-10 w-40"
    />

    <ul class="flex flex-col gap-6 text-lg font-medium text-black">
      <li class="opacity-0 -translate-x-5 transition-all duration-300 delay-75" data-menu-item>
        <a href="#inicio" class="flex items-center gap-3 menu-link hover:text-blue-600 transition-colors">
          <House class="w-5 h-5 text-blue-600" />
          Inicio
        </a>
      </li>

      <li class="opacity-0 -translate-x-5 transition-all duration-300 delay-100" data-menu-item>
        <a href="#nosotros" class="flex items-center gap-3 menu-link hover:text-blue-600 transition-colors">
          <Users class="w-5 h-5 text-blue-600" />
          Sobre nosotros
        </a>
      </li>

      {hasDropdown ? (
        <li class="opacity-0 -translate-x-5 transition-all duration-300 delay-150" data-menu-item>
          <span class="flex items-center gap-3 text-base font-bold uppercase tracking-[.07em] text-blue-600">
            <Wrench class="w-5 h-5" />
            {barrio}
          </span>
          <ul class="mt-3 ml-8 flex flex-col gap-3 border-l border-slate-200 pl-4">
            {sections.map((section) => (
              <li>
                <a href={`#${section.id}`} class="block menu-link hover:text-blue-600 transition-colors">
                  {section.label}
                </a>
              </li>
            ))}
          </ul>
        </li>
      ) : (
        <>
          <li class="opacity-0 -translate-x-5 transition-all duration-300 delay-150" data-menu-item>
            <a href="#servicios" class="flex items-center gap-3 menu-link hover:text-blue-600 transition-colors">
              <Wrench class="w-5 h-5 text-blue-600" />
              Servicios
            </a>
          </li>

          <li class="opacity-0 -translate-x-5 transition-all duration-300 delay-200" data-menu-item>
            <a href="#faq" class="flex items-center gap-3 menu-link hover:text-blue-600 transition-colors">
              <Info class="w-5 h-5 text-blue-600" />
              Preguntas frecuentes
            </a>
          </li>
        </>
      )}

      <li class="pt-4 opacity-0 -translate-x-5 transition-all duration-300 delay-300" data-menu-item>
        <a href="#contacto" class="block text-center rounded-xl px-4 py-3 text-lg font-semibold text-white bg-blue-600 shadow-lg shadow-blue-500/30 hover:bg-blue-500 hover:shadow-blue-400/60 transition-all duration-200 ease-in menu-link">
          Contacto
        </a>
      </li>
    </ul>
  </nav>
</div>

<script>
  // <details> no se cierra solo al seguir un ancla ni al clickear afuera.
  const navDropdown = document.querySelector("[data-nav-dropdown]");
  if (navDropdown) {
    navDropdown.querySelectorAll("a").forEach((link) =>
      link.addEventListener("click", () => navDropdown.removeAttribute("open"))
    );
    document.addEventListener("click", (event) => {
      if (!navDropdown.contains(event.target as Node)) navDropdown.removeAttribute("open");
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") navDropdown.removeAttribute("open");
    });
  }

  const menuButton = document.getElementById("menu-button");
  const overlay = document.getElementById("mobile-overlay");
  const menu = document.getElementById("mobile-menu");
  const backdrop = document.getElementById("mobile-backdrop");
  const iconMenu = document.getElementById("icon-menu");
  const iconClose = document.getElementById("icon-close");
  const menuLinks = document.querySelectorAll(".menu-link");
  const menuItems = document.querySelectorAll("[data-menu-item]");
  
  let isOpen = false;

  function openMenu() {
    isOpen = true;
    document.body.classList.add("overflow-hidden");
    
    overlay?.classList.remove("hidden");
    void overlay?.offsetWidth;
    
    backdrop?.classList.remove("opacity-0");
    backdrop?.classList.add("opacity-100");
    
    menu?.classList.remove("-translate-x-full");
    menu?.classList.add("translate-x-0");
    
    setTimeout(() => {
      menuItems.forEach((item) => {
        item.classList.remove("opacity-0", "translate-x-[-20px]");
        item.classList.add("opacity-100", "translate-x-0");
      });
    }, 150);
    
    iconMenu?.classList.add("hidden");
    iconClose?.classList.remove("hidden");
  }

  function closeMenu() {
    isOpen = false;
    
    menuItems.forEach((item) => {
      item.classList.remove("opacity-100", "translate-x-0");
      item.classList.add("opacity-0", "translate-x-[-20px]");
    });
    
    menu?.classList.remove("translate-x-0");
    menu?.classList.add("-translate-x-full");
    
    backdrop?.classList.remove("opacity-100");
    backdrop?.classList.add("opacity-0");
    
    setTimeout(() => {
      overlay?.classList.add("hidden");
      document.body.classList.remove("overflow-hidden");
    }, 300);
    
    iconMenu?.classList.remove("hidden");
    iconClose?.classList.add("hidden");
  }

  function toggleMenu() {
    if (isOpen) {
      closeMenu();
    } else {
      openMenu();
    }
  }

  menuButton?.addEventListener("click", toggleMenu);
  backdrop?.addEventListener("click", closeMenu);
  
  menuLinks.forEach((link) => {
    link.addEventListener("click", closeMenu);
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && isOpen) {
      closeMenu();
    }
  });
</script>