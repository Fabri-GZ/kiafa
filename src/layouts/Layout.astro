---
import "../styles/global.css";
import { plumberNode, jsonLdGraph } from "../lib/schema";

// Declared as an interface (not an `Astro.props as {...}` cast) so Astro
// type-checks these props at every call site. A cast would silently accept
// a misspelled or wrongly-shaped prop and ship a page with an incomplete graph.
interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  canonical?: string;
  schemaNodes?: object[];
}

const {
  title = "Destapaciones en CABA y GBA | Cloacas, caños y pluviales",
  description = "Destapaciones de cloacas, cañerías, baños y pluviales en CABA y GBA. Empresa con más de 17 años de experiencia. Presupuesto sin cargo antes de empezar.",
  keywords = "destapaciones, kiafadestapaciones, destapaciones caba, destapaciones liniers, destapación de cañerías, destapación de desagues, destapación pluviales, destapación de baños, destapación de cocinas, destapaciones consorcios, destapaciones sin roturas",
  canonical = Astro.url.href,
  schemaNodes = [],
} = Astro.props;

const jsonLd = jsonLdGraph([plumberNode(), ...schemaNodes]);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content="index, follow" />
    <meta name="googlebot" content="index, follow">
    <meta name="author" content="Kiafa Destapaciones" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Kiafa Destapaciones" />
    <meta name="author" content="Kiafa Destapaciones" />
    <meta name="theme-color" content="#0f172a">
    
    <link rel="shortcut icon" href="/favicon.ico">
    
    <link rel="manifest" href="/site.webmanifest">
    <link rel="canonical" href={canonical} />
    <script type="application/ld+json" set:html={jsonLd} />
  </head>

  <body>
    <slot />
  </body>
</html>
