---
import "../styles/global.css";
import { plumberNode, jsonLdGraph } from "../lib/schema";

const {
  title = "Kiafa Destapaciones | Destapaciones en CABA y GBA",
  description = "Destapaciones en CABA y GBA. Cloacas, cañerías, baños, cocinas, pluviales y video inspección.",
  keywords = "destapaciones, kiafadestapaciones, destapaciones caba, destapaciones liniers, destapación de cañerías, destapación de desagues, destapación pluviales, destapación de baños, destapación de cocinas, destapaciones 24 horas, destapaciones sin roturas",
  canonical = Astro.url.href,
  schemaNodes = [],
} = Astro.props as {
  title?: string;
  description?: string;
  keywords?: string;
  canonical?: string;
  schemaNodes?: object[];
};

const jsonLd = jsonLdGraph([plumberNode(), ...schemaNodes]);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content="index, follow" />
    <meta name="googlebot" content="index, follow">
    <meta name="author" content="Kiafa Destapaciones" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Kiafa Destapaciones" />
    <meta name="author" content="Kiafa Destapaciones" />
    <meta name="theme-color" content="#0f172a">
    
    <link rel="shortcut icon" href="/favicon.ico">
    
    <link rel="manifest" href="/site.webmanifest">
    <link rel="canonical" href={canonical} />
    <script type="application/ld+json" set:html={jsonLd} />
  </head>

  <body>
    <slot />
  </body>
</html>
